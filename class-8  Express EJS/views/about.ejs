<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'About' }) %>
<body class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-blue-50/40 text-slate-800 font-sans flex flex-col">
  <%- include('partials/nav') %>

  <main class="flex-1 flex items-center justify-center p-6 sm:p-10">
    <div class="w-full max-w-md bg-white/90 backdrop-blur-xl rounded-2xl border border-slate-200/80 shadow-xl shadow-slate-200/50 p-8 sm:p-10 text-center relative overflow-hidden">
      <div class="absolute top-0 inset-x-0 h-1.5 bg-gradient-to-r from-blue-500 to-indigo-500"></div>

      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200/60 mb-5">
        Overview
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-2">About This Project</h1>
      <p class="text-slate-500 text-sm mb-6">A minimal Express.js & EJS setup</p>

      <div class="bg-slate-50/80 rounded-xl p-4 border border-slate-100 text-slate-600 text-sm leading-relaxed mb-6">
        <p class="mb-4">This project demonstrates clean architecture with Express routers, EJS template engine partials, and Tailwind CSS v4 styling.</p>
        
        <div class="flex flex-wrap items-center justify-center gap-2 pt-2 border-t border-slate-200/60">
          <span class="px-2.5 py-1 rounded-md bg-white border border-slate-200 text-xs font-medium text-slate-700">Node.js</span>
          <span class="px-2.5 py-1 rounded-md bg-white border border-slate-200 text-xs font-medium text-slate-700">Express</span>
          <span class="px-2.5 py-1 rounded-md bg-white border border-slate-200 text-xs font-medium text-slate-700">EJS</span>
          <span class="px-2.5 py-1 rounded-md bg-white border border-slate-200 text-xs font-medium text-slate-700">Tailwind CSS v4</span>
        </div>
      </div>

      <div class="flex items-center justify-center">
        <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-medium text-sm transition">
          <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Back home</span>
        </a>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
