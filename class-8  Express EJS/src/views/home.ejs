<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Home' }) %>
<body class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-blue-50/40 text-slate-800 font-sans flex flex-col">
  <%- include('partials/nav') %>

  <main class="flex-1 flex items-center justify-center p-6 sm:p-10">
    <div class="w-full max-w-md bg-white/90 backdrop-blur-xl rounded-2xl border border-slate-200/80 shadow-xl shadow-slate-200/50 p-8 sm:p-10 text-center relative overflow-hidden">
      <div class="absolute top-0 inset-x-0 h-1.5 bg-gradient-to-r from-blue-500 via-indigo-500 to-cyan-500"></div>

      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200/60 mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-600 animate-pulse"></span>
        Express + EJS
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-2">Welcome to Express</h1>
      <p class="text-slate-500 text-sm mb-6">This is the <strong class="text-blue-600 font-semibold">home</strong> page.</p>

      <div class="bg-slate-50/80 rounded-xl p-4 border border-slate-100 text-slate-600 text-sm leading-relaxed mb-6">
        A small Node.js + Express server that handles routing, middleware, EJS view templates, and form submissions.
      </div>

      <div class="flex items-center justify-center">
        <a href="/contact" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm shadow-sm shadow-blue-500/25 transition group">
          <span>Get in touch</span>
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
